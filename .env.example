# Telegram Bot API token (from @BotFather)
BOT_TOKEN=

# Private chat ID with the bot (use @userinfobot to find)
CHAT_ID=

# Port for HTTP notifications server
NOTIFY_SERVER_PORT=8787

# Token for HTTP notifications endpoint authorization
NOTIFY_TOKEN=

# Absolute path that serves BOTH as the clone destination for NOTES_REPO
# AND the directory where notes live (notes are written under <NOTES_ROOT>/00 Inbox/).
# Must be absolute (relative paths like '.' are rejected).
NOTES_ROOT=/home/user/homelab-notes

# Git remote for the notes repo (https only). Must start with https://
# (http:// is allowed for local testing but tokens will travel in cleartext).
NOTES_REPO=

# GitHub fine-grained token with read+write access to NOTES_REPO. Bot
# loads it via dotenvy, then passes GH_TOKEN to child `git`/`gh` processes.
# `gh` must be installed on the host (critical dependency, bot refuses to
# start otherwise).
GH_TOKEN=

# Debounce window for quick notes (seconds). Messages within this window are merged into one file.
# Default: 45
DEBOUNCE_SECS=45
